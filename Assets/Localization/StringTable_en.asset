  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StringTable_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 557c809a778924845a1a622eff0a5bd3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 131255492608
    m_Localized: Margaret Thorne
    m_Metadata:
      m_Items: []
  - m_Id: 1239155728384
    m_Localized: Where are you going?
    m_Metadata:
      m_Items: []
  - m_Id: 1687375831040
    m_Localized: NPC1
    m_Metadata:
      m_Items: []
  - m_Id: 1973509390921728
    m_Localized: Oliver Windsor
    m_Metadata:
      m_Items: []
  - m_Id: 1974118873624576
    m_Localized: Do you know how to get to the White Horse Manor?
    m_Metadata:
      m_Items: []
  - m_Id: 2160592655020032
    m_Localized: So you are a guest of the Duke of Windsor... It's been a long time
      since we had any guests here.
    m_Metadata:
      m_Items: []
  - m_Id: 2161043110686720
    m_Localized: What does it mean?
    m_Metadata:
      m_Items: []
  - m_Id: 2161376859844608
    m_Localized: Too much alike....
    m_Metadata:
      m_Items: []
  - m_Id: 2161802732695552
    m_Localized: What do you mean?
    m_Metadata:
      m_Items: []
  - m_Id: 2161905312788480
    m_Localized: Just keep walking along the village road.
    m_Metadata:
      m_Items: []
  - m_Id: 2163670007476224
    m_Localized: "That devil has returned to claim lives\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2170519586926592
    m_Localized: (What kind of secret is hidden here...)
    m_Metadata:
      m_Items: []
  - m_Id: 2177699253907456
    m_Localized: The Duke of Windsor
    m_Metadata:
      m_Items: []
  - m_Id: 2178908241063936
    m_Localized: (Knock knock knock...)
    m_Metadata:
      m_Items: []
  - m_Id: 2178129199427584
    m_Localized: What are you doing?
    m_Metadata:
      m_Items: []
  - m_Id: 2181959576252416
    m_Localized: ' Should I call you uncle?'
    m_Metadata:
      m_Items: []
  - m_Id: 2182240699478016
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2556641144008704
    m_Localized: My father passed away a few days ago. I brought his ashes back and
      wanted to have them buried here.
    m_Metadata:
      m_Items: []
  - m_Id: 2556901157302272
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 2563639067602944
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2563764133359616
    m_Localized: Should I call you uncle?
    m_Metadata:
      m_Items: []
  - m_Id: 2563899487744000
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2564025224589312
    m_Localized: As you wish.
    m_Metadata:
      m_Items: []
  - m_Id: 2565048651542528
    m_Localized: 'Just stay in the room on the right side of the first floor. '
    m_Metadata:
      m_Items: []
  - m_Id: 2565209071087616
    m_Localized: 'The kitchen is on the left. If you want to eat something, go to
      the kitchen and get it yourself. '
    m_Metadata:
      m_Items: []
  - m_Id: 2565332563980288
    m_Localized: You can't go up to the third floor. The manor has long had no servants.
    m_Metadata:
      m_Items: []
  - m_Id: 2564151322144768
    m_Localized: Alright.
    m_Metadata:
      m_Items: []
  - m_Id: 2565909058482176
    m_Localized: "It\u2019s too late now."
    m_Metadata:
      m_Items: []
  - m_Id: 2566038201102336
    m_Localized: "Tomorrow morning, I\u2019ll arrange for your father\u2019s ashes
      to be placed. Once that\u2019s done, you should leave as soon as possible."
    m_Metadata:
      m_Items: []
  - m_Id: 2566232749699072
    m_Localized: "(Uncle seems to hold a deep grudge against Father\u2026 and even
      looks at me with the same disdain.)"
    m_Metadata:
      m_Items: []
  - m_Id: 15885906249838592
    m_Localized: "(The \u201Celdest son\u201D they mentioned must have been my father\u2014I
      never expected he had been a missionary before leaving home.)"
    m_Metadata:
      m_Items: []
  - m_Id: 16049792777252864
    m_Localized: "The horse\u2019s color has changed. What could be the connection
      between the black horse and the white horse?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
