MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StringTable_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 557c809a778924845a1a622eff0a5bd3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 131255492608
    m_Localized: Margaret Thorne
    m_Metadata:
      m_Items: []
  - m_Id: 1239155728384
    m_Localized: Where are you going?
    m_Metadata:
      m_Items: []
  - m_Id: 1687375831040
    m_Localized: NPC1
    m_Metadata:
      m_Items: []
  - m_Id: 1973509390921728
    m_Localized: Oliver Windsor
    m_Metadata:
      m_Items: []
  - m_Id: 1974118873624576
    m_Localized: Do you know how to get to the White Horse Manor?
    m_Metadata:
      m_Items: []
  - m_Id: 2160592655020032
    m_Localized: So you are a guest of the Duke of Windsor... It's been a long time
      since we had any guests here.
    m_Metadata:
      m_Items: []
  - m_Id: 2161043110686720
    m_Localized: What does it mean?
    m_Metadata:
      m_Items: []
  - m_Id: 2161376859844608
    m_Localized: Too much alike....
    m_Metadata:
      m_Items: []
  - m_Id: 2161802732695552
    m_Localized: What do you mean?
    m_Metadata:
      m_Items: []
  - m_Id: 2161905312788480
    m_Localized: Just keep walking along the village road.
    m_Metadata:
      m_Items: []
  - m_Id: 2163670007476224
    m_Localized: "That devil has returned to claim lives\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2170519586926592
    m_Localized: (What kind of secret is hidden here...)
    m_Metadata:
      m_Items: []
  - m_Id: 2177699253907456
    m_Localized: The Duke of Windsor
    m_Metadata:
      m_Items: []
  - m_Id: 2178908241063936
    m_Localized: (Knock knock knock...)
    m_Metadata:
      m_Items: []
  - m_Id: 2178129199427584
    m_Localized: What are you doing?
    m_Metadata:
      m_Items: []
  - m_Id: 2181959576252416
    m_Localized: ' Should I call you uncle?'
    m_Metadata:
      m_Items: []
  - m_Id: 2182240699478016
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2556641144008704
    m_Localized: My father passed away a few days ago. I brought his ashes back and
      wanted to have them buried here.
    m_Metadata:
      m_Items: []
  - m_Id: 2556901157302272
    m_Localized: Come in.
    m_Metadata:
      m_Items: []
  - m_Id: 2563639067602944
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2563764133359616
    m_Localized: Should I call you uncle?
    m_Metadata:
      m_Items: []
  - m_Id: 2563899487744000
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 2564025224589312
    m_Localized: As you wish.
    m_Metadata:
      m_Items: []
  - m_Id: 2565048651542528
    m_Localized: 'Just stay in the room on the right side of the first floor. '
    m_Metadata:
      m_Items: []
  - m_Id: 2565209071087616
    m_Localized: 'The kitchen is on the left. If you want to eat something, go to
      the kitchen and get it yourself. '
    m_Metadata:
      m_Items: []
  - m_Id: 2565332563980288
    m_Localized: You can't go up to the third floor. The manor has long had no servants.
    m_Metadata:
      m_Items: []
  - m_Id: 2564151322144768
    m_Localized: Alright.
    m_Metadata:
      m_Items: []
  - m_Id: 2565909058482176
    m_Localized: "It\u2019s too late now."
    m_Metadata:
      m_Items: []
  - m_Id: 2566038201102336
    m_Localized: "Tomorrow morning, I\u2019ll arrange for your father\u2019s ashes
      to be placed. Once that\u2019s done, you should leave as soon as possible."
    m_Metadata:
      m_Items: []
  - m_Id: 2566232749699072
    m_Localized: "(Uncle seems to hold a deep grudge against Father\u2026 and even
      looks at me with the same disdain.)"
    m_Metadata:
      m_Items: []
  - m_Id: 15885906249838592
    m_Localized: "(The \u201Celdest son\u201D they mentioned must have been my father\u2014I
      never expected he had been a missionary before leaving home.)"
    m_Metadata:
      m_Items: []
  - m_Id: 16049792777252864
    m_Localized: "The horse\u2019s color has changed. What could be the connection
      between the black horse and the white horse?"
    m_Metadata:
      m_Items: []
  - m_Id: 22981599049347072
    m_Localized: The kitchen is shrouded in darkness. Perhaps finding a light source
      is the only way to continue exploring.
    m_Metadata:
      m_Items: []
  - m_Id: 24948378868969472
    m_Localized: "Why is only my uncle\u2019s portrait hanging in the hall\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 24975560844570624
    m_Localized: '? ? ?'
    m_Metadata:
      m_Items: []
  - m_Id: 24975859617427456
    m_Localized: What is it that you seek?
    m_Metadata:
      m_Items: []
  - m_Id: 24976384404549632
    m_Localized: "A book\u2014one that describes a way to restore my broken body."
    m_Metadata:
      m_Items: []
  - m_Id: 24976618991972352
    m_Localized: I am a creation of the heavens, all-knowing and all-powerful.
    m_Metadata:
      m_Items: []
  - m_Id: 24976848147771392
    m_Localized: "Then please tell me\u2014how can I regain my body?"
    m_Metadata:
      m_Items: []
  - m_Id: 24977089932619776
    m_Localized: "Take this apple. Gather dried toads and black-and-white flowers,
      then cast them into the town\u2019s well. That is the first step."
    m_Metadata:
      m_Items: []
  - m_Id: 24977527767625728
    m_Localized: Why throw them into the well? What does that have to do with my
      body?
    m_Metadata:
      m_Items: []
  - m_Id: 24977916248256512
    m_Localized: You will understand soon enough.
    m_Metadata:
      m_Items: []
  - m_Id: 24978005649846272
    m_Localized: And where can I find these things?
    m_Metadata:
      m_Items: []
  - m_Id: 24978318377152512
    m_Localized: "For the dried toads, seek the answer in the room at the end of
      the second floor. As for the flowers\u2014ask the fountain in the garden."
    m_Metadata:
      m_Items: []
  - m_Id: 25482170675294208
    m_Localized: It seems like you need a key to open the door.
    m_Metadata:
      m_Items: []
  - m_Id: 25495273903288320
    m_Localized: "It still doesn\u2019t seem to open."
    m_Metadata:
      m_Items: []
  - m_Id: 25496246566580224
    m_Localized: Why is this painting in such a ruined state, and what kind of secrets
      are hidden within the manor?
    m_Metadata:
      m_Items: []
  - m_Id: 25496499877376000
    m_Localized: Why are there black horse statues everywhere in the manor? What
      exactly do they symbolize?
    m_Metadata:
      m_Items: []
  - m_Id: 25527104673476608
    m_Localized: Crow
    m_Metadata:
      m_Items: []
  - m_Id: 25527220666953728
    m_Localized: 1x9=1
    m_Metadata:
      m_Items: []
  - m_Id: 25528912057790464
    m_Localized: What secret is the statue hiding?
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
