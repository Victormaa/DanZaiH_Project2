    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: bubble_1
      value: 
      objectReference: {fileID: 1198396398}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: bubble_2
      value: 
      objectReference: {fileID: 2145997022}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: inspectorDialogue.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: inspectorDialogue.Array.data[0].text
      value: Should I call you uncle?
      objectReference: {fileID: 0}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: inspectorDialogue.Array.data[1].text
      value: As you wish.
      objectReference: {fileID: 0}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: inspectorDialogue.Array.data[2].text
      value: "Just find a place to settle down, but don\u2019t go up to the third
        floor. If you\u2019re hungry, help yourself in the kitchen\u2014the manor
        hasn\u2019t had servants for a long time."
      objectReference: {fileID: 0}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: inspectorDialogue.Array.data[3].text
      value: Alright.
      objectReference: {fileID: 0}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: inspectorDialogue.Array.data[4].text
      value: "It\u2019s too late now. Tomorrow morning, I\u2019ll arrange for your
        father\u2019s ashes to be placed. Once that\u2019s done, you should leave
        as soon as possible."
      objectReference: {fileID: 0}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: inspectorDialogue.Array.data[5].text
      value: "(Uncle seems to hold a deep grudge against Father\u2026 and even looks
        at me with the same disdain.)"
      objectReference: {fileID: 0}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: inspectorDialogue.Array.data[6].text
      value: Just keep walking along the village road.
      objectReference: {fileID: 0}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: inspectorDialogue.Array.data[7].text
      value: Just keep walking along the village road.
      objectReference: {fileID: 0}
    - target: {fileID: 7592133782259250986, guid: 175639ff10d30b646950cbdd307830c3, type: 3}
      propertyPath: inspectorDialogue.Array.data[1].dialoguer
      value: 1
      objectReference: {fileID: 0}
